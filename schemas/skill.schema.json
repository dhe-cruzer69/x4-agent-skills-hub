{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X4 Agent Skill Metadata",
  "type": "object",
  "required": ["name", "quality", "security", "verified"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "quality": {"type": "integer", "minimum": 0, "maximum": 100},
    "security": {"type": "integer", "minimum": 0, "maximum": 100},
    "documentation": {"type": "integer", "minimum": 0, "maximum": 100},
    "maintenance": {"type": "integer", "minimum": 0, "maximum": 100},
    "verified": {"type": "boolean"},
    "compatibility": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": true
}
